# SQLite file
DATABASE_URL=./data/dabei.db
# Password for /settings
ADMIN_PASSWORD=
# Long random string, signs the admin and login cookies. Optional: if empty, a key is generated
# once and stored next to the SQLite file (.cookie-secret), so sessions survive restarts.
COOKIE_SECRET=

# Optional: sign in with Outline (turns on automatically once all four are set).
# Create an OAuth client in Outline (Settings -> Applications) with this redirect URI.
OUTLINE_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
